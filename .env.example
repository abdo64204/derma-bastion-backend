# ==============================================================================
# Derma Bastion Backend - Environment Variables
# ==============================================================================
# For PythonAnywhere, create a .env file in the root directory:
# /home/<your-username>/derma-bastion-backend/.env
# ==============================================================================

# Core Django Settings
DJANGO_SECRET_KEY=generate-a-secure-random-secret-key-for-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourusername.pythonanywhere.com,localhost,127.0.0.1

# CORS & CSRF Settings
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://derma-bastion.vercel.app,http://localhost:4200
CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com,https://derma-bastion.vercel.app,http://localhost:4200

# Superuser initialization (runs with: python manage.py init_admin)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin123456
DJANGO_SUPERUSER_EMAIL=admin@dermabastion.com

# Database (Leave commented for SQLite default, or configure for PythonAnywhere MySQL)
# USE_MYSQL=False
# DB_NAME=yourusername$derma
# DB_USER=yourusername
# DB_PASSWORD=your_mysql_password
# DB_HOST=yourusername.mysql.pythonanywhere-services.com
# DB_PORT=3306
